node: {
  calculator: "TextRenderDataCalculator"
  input_stream: "FPS:fps"
  input_stream: "THREATEN:threaten"
  input_stream: "SOS:sos"
  input_stream: "ALL_EYES_CLOSED:all_eyes_closed"
