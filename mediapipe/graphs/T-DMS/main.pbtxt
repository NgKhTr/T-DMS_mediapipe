      payload_path: "http_post_payload/threaten_alert.json"
      verbose: true
    }
  }
}
  # === Send image
node: {
  calculator: "ConditionCalculator"
  input_stream: "sos_cooling"
  input_stream: "threaten_cooling"
  output_stream: "post_image_signal"
  node_options: {
    [type.googleapis.com/mediapipe.ConditionCalculatorOptions]: {
      logic_type: OR
    }
  }
}
