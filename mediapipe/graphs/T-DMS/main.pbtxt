# === Server interaction
  # === Cooling
node: {
  calculator: "CoolingCalculator"
  input_stream: "TRIGGER:sos"
  output_stream: "TRIGGER:sos_cooling"
  node_options: {
    [type.googleapis.com/mediapipe.CoolingCalculatorOptions]: {
      cool_duration_s: 30
      verbose: false
    }
  }
}
node: {
  calculator: "CoolingCalculator"
  input_stream: "TRIGGER:threaten"
  output_stream: "TRIGGER:threaten_cooling"
  node_options: {
    [type.googleapis.com/mediapipe.CoolingCalculatorOptions]: {
      cool_duration_s: 30
      verbose: false
    }
  }
}
  # === Http Post
node: {
  calculator: "HttpPostCalculator"
  input_stream: "TRIGGER:sos_cooling"
  output_stream: "RESPONSE:sos_http_post_response"
  node_options: {
    [type.googleapis.com/mediapipe.HttpPostCalculatorOptions]: {
      url: "https://scity-dev.innovation.com.vn/api/device/alarm/noauth/AICAM003"
      payload_path: "http_post_payload/sos_alert.json"
      verbose: true
    }
  }
}
node: {
  calculator: "HttpPostCalculator"
  input_stream: "TRIGGER:threaten_cooling"
  output_stream: "RESPONSE:threaten_http_post_response"
  node_options: {
