}


node: {
  calculator: "SOSHandSignCalculator"
  input_stream: "LANDMARKS:hand_landmarks"
  output_stream: "SOS:sos"
  node_options: {
    [type.googleapis.com/mediapipe.SOSHandSignCalculatorOptions]: {
      max_transform_duration_s_threshold: 0.5
      min_keep_duration_s_threshold: 0.3
      verbose: false
    }
  }
}
node: {
  calculator: "AudioAlertCalculator"
  input_stream: "TRIGGER:sos"
  node_options: {
    [type.googleapis.com/mediapipe.AudioAlertCalculatorOptions]: {
      audio_path: "/home/nextwave/Desktop/T-DMS/T-DMS_mediapipe/alert_audio/SOS_detected.wav"
      play_duration_s: -1
      cool_duration_s: 2
    }
  }
}
