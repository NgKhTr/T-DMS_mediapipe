input_stream: "input_video"
output_stream: "output_video"

node: {
  calculator: "FlowLimiterCalculator"
  input_stream: "input_video"
  input_stream: "FINISHED:output_video"
  input_stream_info: {
    tag_index: 'FINISHED'
    back_edge: true
  }
  input_side_packet: "MAX_IN_FLIGHT:max_in_flight"
  output_stream: "throttled_input_video"
  node_options: {
    [type.googleapis.com/mediapipe.FlowLimiterCalculatorOptions] {
      max_in_flight: 1
      max_in_queue: 0
    }
  }
}

node: {
  calculator: "StartLatencyCalculator"
  input_stream: "IMAGE_GPU:throttled_input_video"
  output_stream: "IMAGE_GPU:input_video_ltc"
  output_stream: "START_TIME:start_time"
}

# Object detection
node: {
  calculator: "ObjectDetectionEfficientDetSubgraph"
  input_stream: "IMAGE_GPU:input_video_ltc"
  output_stream: "DETECTIONS:detections"
}
# node: {
#   calculator: "ObjectDetectionMobilenetV2Subgraph"
#   input_stream: "IMAGE_GPU:input_video_ltc"
#   output_stream: "DETECTIONS:detections"
# }
node: {
  calculator: "ObjectDetectionRenderSubgraph"
  input_stream: "DETECTIONS:detections"
  input_stream: "IMAGE_GPU:input_video_ltc"
  output_stream: "IMAGE_GPU:output_image_0"
}

# Detects faces and corresponding landmarks.
node: {
  calculator: "ConstantSidePacketCalculator"
  output_side_packet: "PACKET:num_faces"
  node_options: {
    [type.googleapis.com/mediapipe.ConstantSidePacketCalculatorOptions]: {
      packet: { int_value: 1 }
    }
  }
}
node: {
  calculator: "FaceLandmarkFrontGpu"
  input_stream: "IMAGE:input_video_ltc"
  input_side_packet: "NUM_FACES:num_faces"
  output_stream: "LANDMARKS:multi_face_landmarks"
  output_stream: "ROIS_FROM_LANDMARKS:face_rects_from_landmarks"
  output_stream: "DETECTIONS:face_detections_iris"
  output_stream: "ROIS_FROM_DETECTIONS:face_rects_from_detections"
}
# Yawn
node: {
  calculator: "YawnCalculator"
  input_stream: "MULTI_LANDMARKS:multi_face_landmarks"
  output_stream: "YAWN:yawn"
  node_options: {
    [type.googleapis.com/mediapipe.YawnCalculatorOptions]: {
      mar_threshold: 0.85
      verbose: false
      duration_s_threshold: 0.85
    }
  }
}
# Iris
# Gets the very first and only face from "multi_face_landmarks" vector.
node: {
  calculator: "SplitNormalizedLandmarkListVectorCalculator"
  input_stream: "multi_face_landmarks"
  output_stream: "face_landmarks"
  node_options: {
    [type.googleapis.com/mediapipe.SplitVectorCalculatorOptions] {
      ranges: { begin: 0 end: 1 }
      element_only: true
    }
  }
}
node: {
  calculator: "IrisLandmarksSubgraph"
  input_stream: "FACE_LANDMARKS:face_landmarks"
  input_stream: "IMAGE_GPU:input_video_ltc"
  output_stream: "LEFT_EYE_CONTOUR_LANDMARKS:left_eye_contour_landmarks"
  output_stream: "LEFT_EYE_IRIS_LANDMARKS:left_iris_landmarks"
  output_stream: "LEFT_EYE_ROI:left_eye_rect_from_landmarks"
  output_stream: "RIGHT_EYE_CONTOUR_LANDMARKS:right_eye_contour_landmarks"
  output_stream: "RIGHT_EYE_IRIS_LANDMARKS:right_iris_landmarks"
  output_stream: "RIGHT_EYE_ROI:right_eye_rect_from_landmarks"
}
# render iris and face landmarks
node: {
  calculator: "IrisAndFaceLandmarkRenderSubgraph"
  input_stream: "IMAGE_GPU:output_image_0"
  input_stream: "ROIS_FROM_LANDMARKS:face_rects_from_landmarks" #
  input_stream: "MULTI_FACE_LANDMARKS:multi_face_landmarks" #
  input_stream: "EYE_LANDMARKS_LEFT:left_eye_contour_landmarks" #
  input_stream: "EYE_LANDMARKS_RIGHT:right_eye_contour_landmarks" #
  input_stream: "IRIS_LANDMARKS_LEFT:left_iris_landmarks" #
  input_stream: "IRIS_LANDMARKS_RIGHT:right_iris_landmarks" #
  input_stream: "LEFT_EYE_RECT:left_eye_rect_from_landmarks" #
  input_stream: "RIGHT_EYE_RECT:right_eye_rect_from_landmarks" #
  input_stream: "FACE_DETECTIONS:face_detections_iris"
  output_stream: "IMAGE_GPU:output_image_1"
}


node: {
  calculator: "AllEyesClosedCalculator"
  input_stream: "LEFT_EYE_CONTOUR_LANDMARKS:left_eye_contour_landmarks"
  input_stream: "RIGHT_EYE_CONTOUR_LANDMARKS:right_eye_contour_landmarks"
  output_stream: "ALL_EYES_CLOSED:all_eyes_closed"
  node_options: {
    [type.googleapis.com/mediapipe.AllEyesClosedCalculatorOptions]: {
      ear_threshold: 0.3
      duration_s_threshold: 0.75
      verbose: false
    }
  }
}
# Gaze calculator
node: {
  calculator: "GazeCalculator"
  input_stream: "LEFT_IRIS_LANDMARKS:left_iris_landmarks"
  input_stream: "RIGHT_IRIS_LANDMARKS:right_iris_landmarks"
  input_stream: "IMAGE_GPU:input_video_ltc"
  input_stream: "FACE_LANDMARKS:face_landmarks"
  output_stream: "GAZE_RENDER_DATA:gaze_render_data"
  output_stream: "LEFT_GAZE_DIRECTION:left_gaze_direction"
  output_stream: "RIGHT_GAZE_DIRECTION:right_gaze_direction"
  node_options: {
    [type.googleapis.com/mediapipe.GazeCalculatorOptions]: {
      verbose: false
      color: { r: 0 g: 255 b: 0 }
      thickness: 4.0
    }
  }
}

# Hand tracking
node: {
  calculator: "ConstantSidePacketCalculator"
  output_side_packet: "PACKET:num_hands"
  node_options: {
    [type.googleapis.com/mediapipe.ConstantSidePacketCalculatorOptions]: {
      packet: { 
        int_value: 4
      }
    }
  }
}
node: {
  calculator: "HandLandmarkTrackingGpu"
  input_stream: "IMAGE:input_video_ltc"
  input_side_packet: "NUM_HANDS:num_hands"
  output_stream: "LANDMARKS:hand_landmarks"
  output_stream: "HANDEDNESS:handedness"
  output_stream: "PALM_DETECTIONS:palm_detections"
  output_stream: "HAND_ROIS_FROM_LANDMARKS:hand_rects_from_landmarks"
  output_stream: "HAND_ROIS_FROM_PALM_DETECTIONS:hand_rects_from_palm_detections"
}
node: {
  calculator: "HandLandmarksRenderSubgraph"
  input_stream: "IMAGE:output_image_1"
  input_stream: "LANDMARKS:hand_landmarks"
  output_stream: "IMAGE:output_image_2"
}

node: {
  calculator: "SOSHandSignCalculator"
  input_stream: "LANDMARKS:hand_landmarks"
  output_stream: "SOS:sos"
  node_options: {
    [type.googleapis.com/mediapipe.SOSHandSignCalculatorOptions]: {
      max_transform_duration_s_threshold: 0.5
      min_keep_duration_s_threshold: 0.3
      verbose: true
    }
  }
}
# Hand hold distracting object
node: {
  calculator: "HandHoldObjectCalculator"
  input_stream: "LANDMARKS:hand_landmarks"
  input_stream: "DETECTIONS:detections"
  output_stream: "HOLD:hand_hold_cell_phone"
  node_options: {
    [type.googleapis.com/mediapipe.HandHoldObjectCalculatorOptions]: {
      duration_s_threshold: 1
      label: "smartphone"
      verbose: false
    }
  }
}
node: {
  calculator: "HandHoldObjectCalculator"
  input_stream: "LANDMARKS:hand_landmarks"
  input_stream: "DETECTIONS:detections"
  output_stream: "HOLD:hand_hold_cup"
  node_options: {
    [type.googleapis.com/mediapipe.HandHoldObjectCalculatorOptions]: {
      duration_s_threshold: 1
      label: "cup"
      verbose: false
    }
  }
}
node: {
  calculator: "HandHoldObjectCalculator"
  input_stream: "LANDMARKS:hand_landmarks"
  input_stream: "DETECTIONS:detections"
  output_stream: "HOLD:hand_hold_drink"
  node_options: {
    [type.googleapis.com/mediapipe.HandHoldObjectCalculatorOptions]: {
      duration_s_threshold: 0.5
      label: "drink"
      verbose: false
    }
  }
}
# Threaten detection
node: {
  calculator: "FaceDetectionShortRangeGpu"
  input_stream: "IMAGE:input_video_ltc"
  output_stream: "DETECTIONS:face_detections"
}
node: {
  calculator: "ThreatenCalculator"
  input_stream: "MULTI_HAND_LANDMARKS:hand_landmarks"
  input_stream: "OBJECT_DETECTIONS:detections"
  input_stream: "FACE_DETECTIONS:face_detections"
  output_stream: "THREATEN:threaten"
  output_stream: "FACE_MARGIN_DETECTIONS:face_margin_detections"
  node_options: {
    [type.googleapis.com/mediapipe.ThreatenCalculatorOptions]: {
      labels: "scissors"
      labels: "knife"
      labels: "gun"
      verbose: true
      face_margin_top_ratio: 1
      face_margin_left_ratio: 0.5
      face_margin_right_ratio: 0.5
      face_margin_bottom_ratio: 0.5
    }
  }
}
node: {
  calculator: "DetectionsToRenderDataCalculator"
  input_stream: "DETECTIONS:face_margin_detections"
  output_stream: "RENDER_DATA:face_margin_detections_render_data"
  node_options: {
    [type.googleapis.com/mediapipe.DetectionsToRenderDataCalculatorOptions] {
      thickness: 4.0
      color: { r: 0 g: 0 b: 255 }
    }
  }
}
node: {
  calculator: "AnnotationOverlayCalculator"
  input_stream: "IMAGE_GPU:output_image_2"
  input_stream: "face_margin_detections_render_data"
  input_stream: "gaze_render_data"
  output_stream: "IMAGE_GPU:output_image_3"
}
