input_stream: "input_image"
output_stream: "output_image"

node: {
  calculator: "ImageTransformationCalculator"
  input_stream: "IMAGE:input_image"
  output_stream: "IMAGE:transformed_input_image_cpu"
  node_options: {
    [type.googleapis.com/mediapipe.ImageTransformationCalculatorOptions] {
      output_width: 320
      output_height: 320
    }
  }
}
node: {
  calculator: "TfLiteConverterCalculator"
  input_stream: "IMAGE:transformed_input_image_cpu"
  output_stream: "TENSORS:image_tensor"
}
node: {
  calculator: "TfLiteInferenceCalculator"
  input_stream: "TENSORS:image_tensor"
  output_stream: "TENSORS:detection_tensors"
  node_options: {
    [type.googleapis.com/mediapipe.TfLiteInferenceCalculatorOptions] {
      # model_path: "mediapipe/models/ssdlite_object_detection.tflite"
      model_path: "/home/nextwave/Desktop/T-DMS/Models/efficientdet_lite0.tflite"
      # model_path: "mediapipe/models/efficientdet_lite0_v1.tflite"
    }
  }
}
node: {
  calculator: "CheckFlowCalculator"
  input_stream: "VECTOR:detection_tensors"
  output_stream: "VECTOR:detection_tensors_ckflow"
}
node: {
  calculator: "SplitTfLiteTensorVectorCalculator"
  input_stream: "detection_tensors"
  output_stream: "reordered_detection_tensors"
  options {
    [mediapipe.SplitVectorCalculatorOptions.ext] {
      ranges: { begin: 1 end: 2 }
      ranges: { begin: 0 end: 1 }
      element_only: true
      combine_outputs: true
    }
  }
}
node: {
  calculator: "CheckFlowCalculator"
  input_stream: "VECTOR:reordered_detection_tensors"
  output_stream: "VECTOR:reordered_detection_tensors_ckflow"
}
node: {
  calculator: "AnchorCsvSidePacketCalculator"
  output_side_packet: "anchors"
  node_options: {
    [type.googleapis.com/mediapipe.AnchorCsvSidePacketCalculatorOptions] {
      path: "/home/nextwave/Desktop/T-DMS/Models/efficientdet_lite0_fp16_no_nms_anchors.csv"
      # path: "mediapipe/models/efficientdet_lite0_fp16_no_nms_anchors.csv"
    }
  }
}
node: {
  calculator: "TfLiteTensorsToDetectionsCalculator"
  input_stream: "TENSORS:reordered_detection_tensors"
  input_side_packet: "ANCHORS:anchors"
  output_stream: "DETECTIONS:detections"
  node_options: {
    [type.googleapis.com/mediapipe.TfLiteTensorsToDetectionsCalculatorOptions] {
      min_score_thresh: 0.3
      num_classes: 90
      num_boxes: 19206
      num_coords: 4
      x_scale: 1
      y_scale: 1
      w_scale: 1
      h_scale: 1
      keypoint_coord_offset: 0
      num_keypoints: 0
      num_values_per_keypoint: 2
      apply_exponential_on_box_size: true
      sigmoid_score: false
    }
  }
}
node: {
  calculator: "CheckFlowCalculator"
  input_stream: "VECTOR:detections"
  output_stream: "VECTOR:detections_ckflow"
}
node: {
  calculator: "NonMaxSuppressionCalculator"
  input_stream: "detections_ckflow"
  output_stream: "filtered_detections"
  node_options: {
    [type.googleapis.com/mediapipe.NonMaxSuppressionCalculatorOptions] {
      min_suppression_threshold: 0 # Important the higher the more detections
      min_score_threshold: 0.5
      # overlap_type: JACCARD
      # return_empty_detections: true
      # algorithm: DEFAULT
      # max_num_detections: 2

      multiclass_nms: true # Need true because need detect many class that appear overlap

      # num_detection_streams => The number of input, sometime you provide many input to this node
      # max_number_detection => The top k detection to keep
      # min_suppression_threshold => IoU between 2 boxes > value -> Suppressed => The greater the more overlap bounding box appear
    }
  }
}
node: {
  calculator: "DetectionLabelIdToTextCalculator"
  # input_stream: "detections_ckflow"
  input_stream: "filtered_detections"
  output_stream: "output_detections"
  node_options: {
    [type.googleapis.com/mediapipe.DetectionLabelIdToTextCalculatorOptions] {
      label_map_path: "/home/nextwave/Desktop/T-DMS/Models/efficientdet_lite0_labels.txt"
      # label_map_path: "mediapipe/models/labelmap.txt"
    }
  }
}
node: {
  calculator: "DetectionsToRenderDataCalculator"
  input_stream: "DETECTIONS:output_detections"
  output_stream: "RENDER_DATA:render_data"
  node_options: {
    [type.googleapis.com/mediapipe.DetectionsToRenderDataCalculatorOptions] {
      thickness: 4.0
      color { r: 255 g: 0 b: 0 }
    }
  }
}
node: {
  calculator: "CheckFlowCalculator"
  input_stream: "RENDER_DATA:render_data"
  output_stream: "RENDER_DATA:render_data_ckflow"
}
node: {
  calculator: "AnnotationOverlayCalculator"
  input_stream: "IMAGE:input_image"
  input_stream: "render_data_ckflow"
  output_stream: "IMAGE:output_image"
}
